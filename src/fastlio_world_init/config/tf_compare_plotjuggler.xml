<?xml version='1.0' encoding='UTF-8'?>
<root>
  <tabbed_widget name="Main Window" parent="main_window">
    <Tab containers="1" tab_name="Robot Pose Filter">
      <Container>
        <DockSplitter orientation="-" count="4" sizes="0.250000;0.250000;0.250000;0.250000">
          <DockArea name="Robot X Raw vs Filtered">
            <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines" line_width="1.5">
              <range left="0.000000" right="30.000000" top="1.000000" bottom="-1.000000"/>
              <limitY/>
              <curve name="/robot/pose/pose/position/x" color="#1f77b4"/>
              <curve name="/robot/pose_filtered/pose/position/x" color="#ff7f0e"/>
            </plot>
          </DockArea>
          <DockArea name="Robot Y Raw vs Filtered">
            <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines" line_width="1.5">
              <range left="0.000000" right="30.000000" top="1.000000" bottom="-1.000000"/>
              <limitY/>
              <curve name="/robot/pose/pose/position/y" color="#1f77b4"/>
              <curve name="/robot/pose_filtered/pose/position/y" color="#ff7f0e"/>
            </plot>
          </DockArea>
          <DockArea name="Robot Z Raw vs Filtered">
            <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines" line_width="1.5">
              <range left="0.000000" right="30.000000" top="1.000000" bottom="-1.000000"/>
              <limitY/>
              <curve name="/robot/pose/pose/position/z" color="#1f77b4"/>
              <curve name="/robot/pose_filtered/pose/position/z" color="#ff7f0e"/>
            </plot>
          </DockArea>
          <DockArea name="Quality And Filter Status">
            <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines" line_width="1.5">
              <range left="0.000000" right="30.000000" top="1.000000" bottom="0.000000"/>
              <limitY/>
              <curve name="/map_lidar/quality/data.2" color="#2ca02c"/>
              <curve name="/map_lidar/quality/data.7" color="#d62728"/>
              <curve name="/lidar/pose_filter/status/data.7" color="#9467bd"/>
              <curve name="/lidar/pose_filter/status/data.10" color="#8c564b"/>
            </plot>
          </DockArea>
        </DockSplitter>
      </Container>
    </Tab>
    <Tab containers="1" tab_name="TF Compare">
      <Container>
        <DockSplitter orientation="-" count="3" sizes="0.333333;0.333333;0.333334">
          <DockArea name="X Compare">
            <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines" line_width="1.5">
              <range left="0.000000" right="30.000000" top="1.000000" bottom="-1.000000"/>
              <limitY/>
              <curve name="/tf_compare/robot_init_to_base_link/vector/x" color="#1f77b4"/>
              <curve name="/tf_compare/robot_init_to_base_link_highrate/vector/x" color="#ff7f0e"/>
              <curve name="/tf_compare/lidar_world_to_body/vector/x" color="#2ca02c"/>
            </plot>
          </DockArea>
          <DockArea name="Y Compare">
            <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines" line_width="1.5">
              <range left="0.000000" right="30.000000" top="1.000000" bottom="-1.000000"/>
              <limitY/>
              <curve name="/tf_compare/robot_init_to_base_link/vector/y" color="#1f77b4"/>
              <curve name="/tf_compare/robot_init_to_base_link_highrate/vector/y" color="#ff7f0e"/>
              <curve name="/tf_compare/lidar_world_to_body/vector/y" color="#2ca02c"/>
            </plot>
          </DockArea>
          <DockArea name="Z Compare">
            <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines" line_width="1.5">
              <range left="0.000000" right="30.000000" top="1.000000" bottom="-1.000000"/>
              <limitY/>
              <curve name="/tf_compare/robot_init_to_base_link/vector/z" color="#1f77b4"/>
              <curve name="/tf_compare/robot_init_to_base_link_highrate/vector/z" color="#ff7f0e"/>
              <curve name="/tf_compare/lidar_world_to_body/vector/z" color="#2ca02c"/>
            </plot>
          </DockArea>
        </DockSplitter>
      </Container>
    </Tab>
    <currentTabIndex index="0"/>
  </tabbed_widget>
  <use_relative_time_offset enabled="1"/>
  <streaming_buffer_size value="300"/>
  <Plugins>
    <plugin ID="DataStreamROS2">
      <use_header_stamp value="true"/>
      <discard_large_arrays value="true"/>
      <max_array_size value="100"/>
      <boolean_strings_to_number value="true"/>
      <remove_suffix_from_strings value="true"/>
      <selected_topics value="/robot/pose;/robot/pose_filtered;/lidar/pose_filter/status;/map_lidar/quality;/tf_compare/robot_init_to_base_link;/tf_compare/robot_init_to_base_link_highrate;/tf_compare/lidar_world_to_body"/>
    </plugin>
  </Plugins>
  <previouslyLoaded_Streamer name="DataStreamROS2"/>
</root>
