# Copy to config/deploy.env and edit on the destination host.
# Baseline verified locally: Ubuntu 24.04 / ROS 2 Jazzy / system Python 3.12.
TASK1_ROS_SETUP=/opt/ros/jazzy/setup.bash
# If FAST-LIO and driver are already installed, set the real destination path:
# TASK3_BASE_SETUP=/absolute/path/to/lidar_workspace/install/setup.bash
# Leave unset after building bundled vendor into upstream_ws.
ROS_DOMAIN_ID=0
