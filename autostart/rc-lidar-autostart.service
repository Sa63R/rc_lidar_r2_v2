[Unit]
Description=RC LiDAR R2 high-rate relocalization autostart
Documentation=file:@RC_LIDAR_WORKSPACE@/readme.md
After=default.target network-online.target
Wants=network-online.target
ConditionPathExists=@RC_LIDAR_WORKSPACE@/autostart/boot_start.sh

[Service]
Type=oneshot
WorkingDirectory=@RC_LIDAR_WORKSPACE@
Environment=RUN_REASON=boot
Environment=RC_LIDAR_WORKSPACE=@RC_LIDAR_WORKSPACE@
Environment=RC_LIDAR_MODE=relocalization
Environment=RC_LIDAR_MAP_PATH=@RC_LIDAR_WORKSPACE@/maps/lan1.pcd
Environment=RC_LOCALIZATION_MAP_PATH=@RC_LIDAR_WORKSPACE@/maps/lan1.pcd
Environment=RC_RELOCALIZATION_ASSUME_MAP_ORIGIN=1
Environment=RC_AUTOSTART_START_DELAY=15
Environment=RC_AUTOSTART_HEADLESS=1
Environment=RC_AUTOSTART_PLOTJUGGLER=1
Environment=RC_AUTOSTART_CANFD=1
Environment=RC_AUTOSTART_CANFD_TX_MONITOR=1
Environment=RC_AUTOSTART_FDCAN_GATEWAY=auto
Environment=RC_CANFD_TRANSPORT=gateway
Environment=RC_FDCAN_GATEWAY_SOCKET=/tmp/rc_fdcan_gateway.sock
Environment=RC_CAN_RESTART_LISTENER=auto
Environment=RC_CANFD_RESTART_ENABLED=1
Environment=RC_CANFD_RESTART_CAN_ID=0x30
Environment=RC_CANFD_RESTART_PAYLOAD_HEX=A55A01FE00000000
Environment=RC_CANFD_SERIAL_PRESENCE_CHECK_PERIOD_SEC=0.5
Environment=RC_CAN_RESTART_DEBOUNCE_SEC=8.0
Environment=RC_CAN_RESTART_MIN_INTERVAL_SEC=15
Environment=RC_CAN_DEBUG_CSV=1
Environment=RC_MAP_LOCALIZER_LOCALIZE_PERIOD_SEC=0.2
Environment=RC_MAP_LOCALIZER_EXECUTOR_THREADS=3
Environment=RC_MAP_LOCALIZER_ODOM_BUFFER_DURATION_SEC=2.0
Environment=RC_MAP_LOCALIZER_MAX_SCAN_ODOM_DELTA_SEC=0.05
Environment=RC_MAP_LOCALIZER_MAX_SCAN_AGE_SEC=0.5
Environment=RC_MAP_LOCALIZER_MAP_LEAF_SIZE=0.10
Environment=RC_MAP_LOCALIZER_SCAN_LEAF_SIZE=0.10
Environment=RC_FASTLIO_FILTER_SIZE_SURF=0.15
Environment=RC_FASTLIO_FILTER_SIZE_MAP=0.25
Environment=RC_FASTLIO_POINT_FILTER_NUM=3
Environment=RC_FASTLIO_RUNTIME_POS_LOG_ENABLE=0
Environment=RC_FASTLIO_DET_RANGE=100
Environment=FASTLIO_RVIZ=false
Environment=RC_CONTINUOUS_POSE=auto
Environment=RC_CONTINUOUS_POSE_OUTPUT_TOPIC=/robot/pose_continuous
Environment=RC_CONTINUOUS_POSE_STAMP_MATCH_MODE=stamp
Environment=RC_CONTINUOUS_POSE_MAX_STAMP_DELTA=0.03
Environment=RC_MATCH_ORIGIN_ENABLE=0
Environment=RC_MATCH_ORIGIN_OUTPUT_TOPIC=/robot/pose_match
Environment=RC_MATCH_ORIGIN_STATUS_TOPIC=/robot/match_origin/status
Environment=RC_MATCH_ORIGIN_MIN_LOCK_SEC=2.5
Environment=RC_MATCH_ORIGIN_MIN_SAMPLES=20
Environment=RC_MATCH_ORIGIN_MAX_XY_STD=0.08
Environment=RC_MATCH_ORIGIN_MAX_YAW_STD_DEG=5.0
Environment=RC_CAN_POSE_TOPIC=/robot/pose_continuous
Environment=RC_CAN_POSE_TIMEOUT_SEC=0.5
Environment=RC_CAN_RAW_ODOM_POSE_TOPIC=/Odometry
Environment=RC_CAN_RAW_ODOM_POSE_STRICT=1
Environment=RC_CAN_RAW_ODOM_POSE_YAW_OFFSET_RAD=0.0
Environment=RC_CAN_USE_YAW_POSE_TOPIC=0
Environment=RC_CAN_USE_RAW_ODOM_YAW=0
Environment=RC_CAN_RAW_ODOM_YAW_TOPIC=/Odometry
Environment=RC_CAN_RAW_ODOM_YAW_STRICT=0
Environment=RC_CAN_RAW_ODOM_YAW_OFFSET_RAD=0.0
Environment=RC_CAN_RAW_ODOM_YAW_IGNORE_READY_GATE=1
Environment=RC_CAN_REQUIRE_READY=0
Environment=RC_CAN_READY_QUALITY_TOPIC=/map_lidar/quality
Environment=RC_CAN_READY_MAX_FITNESS=0.05
Environment=RC_CAN_READY_MIN_ACCEPTS=5
Environment=RC_POSE_FILTER=0
Environment=RC_POSE_FILTER_STABLE=0
Environment=RC_ROBOT_POSE_YAW_FUSION=0
Environment=RC_HEALTH_MONITOR=1
Environment=RC_READY_NOTIFY=1
Environment=RC_READY_NOTIFY_POSE_TOPIC=/robot/pose_continuous
Environment=RC_READY_NOTIFY_POPUP=0
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/rc2/.Xauthority
Environment=XDG_SESSION_TYPE=x11
ExecStart=@RC_LIDAR_WORKSPACE@/autostart/boot_start.sh
ExecStop=@RC_LIDAR_WORKSPACE@/autostart/stop_all.sh --quiet
RemainAfterExit=yes
KillMode=process
TimeoutStartSec=240
Restart=no

[Install]
WantedBy=default.target
