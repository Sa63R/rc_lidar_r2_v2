[Unit]
Description=RC LiDAR low-load relocalization autostart
Documentation=file:/home/orangepi/RC_LIDAR_NOW/readme.md
After=default.target
ConditionPathExists=/home/orangepi/RC_LIDAR_NOW/autostart/boot_start.sh

[Service]
Type=oneshot
WorkingDirectory=/home/orangepi/RC_LIDAR_NOW
Environment=RUN_REASON=boot
Environment=RC_LIDAR_MODE=relocalization
Environment=RC_LIDAR_MAP_PATH=/home/orangepi/RC_LIDAR_NOW/maps/mid360_map_20260625_064655.pcd
Environment=RC_RELOCALIZATION_ASSUME_MAP_ORIGIN=1
Environment=RC_AUTOSTART_HEADLESS=1
Environment=RC_AUTOSTART_PLOTJUGGLER=0
Environment=RC_CAN_POSE_SOURCE=pose_topic
Environment=RC_CAN_POSE_TOPIC=/robot/pose_filtered
Environment=RC_CAN_USE_YAW_POSE_TOPIC=0
Environment=RC_CAN_USE_RAW_ODOM_YAW=1
Environment=RC_CAN_RAW_ODOM_YAW_TOPIC=/Odometry
Environment=RC_CAN_RAW_ODOM_YAW_STRICT=1
Environment=RC_CAN_RAW_ODOM_YAW_OFFSET_RAD=0.0
Environment=RC_CAN_RAW_ODOM_YAW_IGNORE_READY_GATE=1
Environment=RC_CAN_REQUIRE_READY=0
Environment=RC_CAN_READY_QUALITY_TOPIC=/map_lidar/quality
Environment=RC_CAN_READY_MAX_FITNESS=0.05
Environment=RC_CAN_READY_MIN_ACCEPTS=5
Environment=RC_POSE_FILTER_STABLE=0
Environment=RC_HEALTH_MONITOR=1
Environment=RC_READY_NOTIFY=1
Environment=RC_READY_NOTIFY_POPUP=0
ExecStart=/home/orangepi/RC_LIDAR_NOW/autostart/boot_start.sh
RemainAfterExit=yes
TimeoutStartSec=240

[Install]
WantedBy=default.target
