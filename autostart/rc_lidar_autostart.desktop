[Desktop Entry]
Type=Application
Name=RC Lidar Autostart
Comment=Start RC LiDAR localization stack after desktop login
Exec=/home/orangepi/RC_LIDAR_NOW/autostart/boot_start.sh
Path=/home/orangepi/RC_LIDAR_NOW
Terminal=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=10
X-MATE-Autostart-Delay=10
